<resources>
    <string name="physical_key_title">Physical Key Assistant</string>
    <string name="physical_key_home_summary">Power &amp; volume key long press, double tap, and combo gestures (Root / Shizuku, screen-off supported)</string>

    <!-- Settings: Tip Card -->
    <string name="physical_key_tip">Reads underlying Linux input events directly via privileged channels (Shizuku / Root).\nFully supports power and volume keys long press, double tap, and combo presses even when screen is off.\nNormal single clicks are passed directly to the system without latency, preserving native power and volume functions.</string>

