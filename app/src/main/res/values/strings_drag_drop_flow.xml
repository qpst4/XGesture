<resources>
    <string name="drag_drop_flow_title">Global drag &amp; drop flow</string>

    <!-- 设置页 -->
    <string name="drag_drop_flow_section_basic">Basics</string>
    <string name="drag_drop_flow_enable_title">Enable global drag &amp; drop flow</string>
    <string name="drag_drop_flow_enable_summary">Long-press an image or text in any app and start dragging: the flow bar slides in from the screen edge.</string>
    <string name="drag_drop_flow_section_layout">Appearance and position</string>
    <string name="drag_drop_flow_position_title">Flow bar position</string>
    <string name="drag_drop_flow_position_summary">Which edge the bar hugs. Pick “Ring compass” to turn it into a disc in the middle of the screen with every target spread around it.</string>
    <string name="drag_drop_flow_position_bottom">Bottom edge (default)</string>
    <string name="drag_drop_flow_position_left">Left edge, vertical</string>
    <string name="drag_drop_flow_position_right">Right edge, vertical</string>
    <string name="drag_drop_flow_position_ring">Ring compass (centred)</string>
    <string name="drag_drop_flow_haptic_title">Haptic feedback</string>
    <string name="drag_drop_flow_haptic_summary">A subtle vibration when you hover a target, Cancel or Restore.</string>
    <string name="drag_drop_flow_inline_actions_title">Show built-in actions inline</string>
    <string name="drag_drop_flow_inline_actions_summary">Split words, copy, search, translate, share and pin sit directly in the bar instead of inside the Actions button. Applies to text and image drags.</string>
    <string name="drag_drop_flow_section_targets">Flow targets</string>
    <string name="drag_drop_flow_text_engines_title">Text search engines</string>
    <string name="drag_drop_flow_text_engines_summary">The default search, translation and quick actions offered when you drag text.</string>
    <string name="drag_drop_flow_image_engines_title">Image search engines</string>
    <string name="drag_drop_flow_image_engines_summary">Reverse image search, shopping and social sharing targets offered when you drag an image.</string>
    <string name="drag_drop_flow_file_engines_title">File share engines</string>
    <string name="drag_drop_flow_file_engines_summary">Manage which apps receive dragged audio or files, and in what order.</string>
    <string name="drag_drop_flow_guide">• Trigger: in WeChat, Gallery, a browser or any app that supports system drag, long-press text or an image and drag to bring up the flow bar.\n• Edge scrolling: with many targets on the bar, drag to either of its edges and it scrolls smoothly by itself.\n• Discard and cancel: release over “Cancel” to drop this flow without disturbing the source app; release over “Restore” to keep everything as it was.</string>

