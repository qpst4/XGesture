<!-- 全局拖拽流转（独立资源文件，避免改动现有 strings.xml）。 -->
<resources>
    <string name="drag_drop_flow_title">グローバルドラッグ＆ドロップフロー</string>

    <!-- 设置页 -->
    <string name="drag_drop_flow_section_basic">基本機能</string>
    <string name="drag_drop_flow_enable_title">グローバルドラッグ＆ドロップフローを有効にする</string>
    <string name="drag_drop_flow_enable_summary">任意のアプリで画像やテキストを長押ししてドラッグを始めると、画面の端からフローバーが自動で現れます。</string>
    <string name="drag_drop_flow_section_layout">外観と位置</string>
    <string name="drag_drop_flow_position_title">フローバーの表示位置</string>
    <string name="drag_drop_flow_position_summary">バーをどの端に沿わせるか。「リングコンパス」を選ぶと画面中央の円盤に変わり、すべてのターゲットが円状に並びます。</string>
    <string name="drag_drop_flow_position_bottom">下端・横並び（既定）</string>
    <string name="drag_drop_flow_position_left">左端・縦並び</string>
    <string name="drag_drop_flow_position_right">右端・縦並び</string>
    <string name="drag_drop_flow_position_ring">リングコンパス（中央）</string>
    <string name="drag_drop_flow_haptic_title">触覚フィードバック</string>
    <string name="drag_drop_flow_haptic_summary">ターゲットや「キャンセル」「復元」に重ねたときに、細かな振動で知らせます。</string>
    <string name="drag_drop_flow_inline_actions_title">組み込み操作を常時表示</string>
    <string name="drag_drop_flow_inline_actions_summary">単語分割・コピー・検索・翻訳・共有・画面固定を「操作」ボタンに収めず、バーに直接並べます。オフにすると「操作」を押し続けて展開する従来の動作に戻ります。テキストと画像のドラッグのみ対象です。</string>
    <string name="drag_drop_flow_section_targets">フローのターゲット</string>
    <string name="drag_drop_flow_text_engines_title">テキスト検索エンジン</string>
    <string name="drag_drop_flow_text_engines_summary">テキストをドラッグしたときに表示する既定の検索・翻訳・クイック操作。</string>
    <string name="drag_drop_flow_image_engines_title">画像検索エンジン</string>
    <string name="drag_drop_flow_image_engines_summary">画像をドラッグしたときに表示する逆画像検索・ショッピング・SNS 共有のターゲット。</string>
    <string name="drag_drop_flow_file_engines_title">ファイル共有エンジン</string>
    <string name="drag_drop_flow_file_engines_summary">音声やファイルをドラッグしたときの共有先アプリと並び順を管理します。</string>
    <string name="drag_drop_flow_guide">• 起動方法：WeChat、ギャラリー、ブラウザなどシステムのドラッグに対応したアプリで、テキストや画像を長押ししてドラッグするとフローバーが現れます。\n• 端でのスクロール：ターゲットが多いときは、バーの両端までドラッグすると自動でスムーズにスクロールします。\n• 破棄とキャンセル：「キャンセル」の上で離すと元のアプリに影響を与えずにこのフローを破棄できます。「復元」の上で離すと元の状態を保ちます。</string>

