    <string name="physical_key_status_channel_fallback">特権チャネル</string>
    <string name="physical_key_status_channel_detail">チャネル: %1$s ・ 低レベルドライバー監視中</string>
    <string name="physical_key_status_not_running">未実行（%1$s）。タップして再試行するか診断を表示します。</string>

