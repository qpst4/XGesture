<?xml version="1.0" encoding="utf-8"?>
<!-- Physical key assistant resources -->
<resources>
    <string name="physical_key_title">物理キーアシスタント</string>
    <string name="physical_key_home_summary">電源キーと音量キーの長押し・ダブルタップ・同時押しのジェスチャー（Root / Shizuku 対応、画面オフでも使用可能）</string>

    <!-- Settings: Tip Card -->
    <string name="physical_key_tip">特権チャネル（Shizuku / Root）を介して Linux の低レベル入力イベントを直接読み取ります。\n画面オフ時でも、電源キーと音量キーの長押し・ダブルタップ・同時押しに完全対応します。\n通常のシングルクリックは遅延なくそのままシステムへ渡され、電源・音量のネイティブ機能を損ないません。</string>

    <!-- Settings: Toggle and Status -->
    <string name="physical_key_enable_title">物理キージェスチャーを有効にする</string>
    <string name="physical_key_enable_summary">低レベルの物理キーイベントを監視し、カスタムアクションを実行します</string>
    <string name="physical_key_status_title">ステータス</string>
    <string name="physical_key_status_disabled">無効</string>
