<?xml version="1.0" encoding="utf-8"?>
<paths>
    <files-path
        name="clipboard_images"
        path="clipboard/images/" />
    <files-path
        name="stash_images"
        path="stash/images/" />
    <files-path
        name="stash_audio"
        path="stash/audio/" />
    <cache-path
        name="update_cache"
        path="update/" />
    <!-- 搜索面板「分享应用」：/data/app 不在 FileProvider 白名单里，先把安装包复制到这里再授权。 -->
    <cache-path
        name="apk_share"
        path="apk_share/" />
    <cache-path
        name="diagnostic_reports"
        path="diagnostics/" />
    <cache-path
        name="float_ball_share"
        path="float_ball_share/" />
    <!-- 取词面板「拖出去」的临时 PNG：系统拖拽只能给 content://，
         没白名单时 getUriForFile 会抛 IllegalArgumentException（图片拖拽直接起不来）。 -->
    <cache-path
        name="pick_drag"
        path="pick_drag/" />
    <cache-path
        name="drag_forward"
        path="drag_forward/" />
    <cache-path
        name="screenshot_cache"
        path="screenshots/" />
    <files-path
        name="crash_reports"
        path="crashes/" />
    <external-cache-path
        name="update_external_cache"
        path="update/" />
    <cache-path
        name="filebrowser_cache"
        path="filebrowser/" />
    <!-- 文件浏览器：仅对 App 可直读的共享存储文件生成 content:// URI。 -->
    <external-path
        name="filebrowser_external"
        path="." />
</paths>
