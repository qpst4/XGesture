    <string name="physical_key_intercept_native_title">拦截原生按键响应</string>
    <string name="physical_key_intercept_native_summary">触发自定义动作时阻止系统原生响应（阻止音量调节弹窗、压制电源关机菜单）</string>
    <string name="physical_key_screen_off_trigger_title">允许熄屏时触发</string>
