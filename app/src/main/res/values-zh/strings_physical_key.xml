<resources>
    <string name="physical_key_title">实体按键助手</string>
    <string name="physical_key_home_summary">电源键与音量键长按、双击、并击自定义（无需 Root，支持 Shizuku，息屏可用）</string>

    <!-- 设置页：说明卡片 -->
    <string name="physical_key_tip">通过特权输入通道（Shizuku / Root）直接读取 Linux 底层硬件按键事件。\n全量支持电源键与音量键长按、双击与双键并击，息屏盲操亦可生效。\n常规单击零延迟直通系统，不影响原生锁屏、开关机与音量调节。</string>

    <!-- 设置页：开关与状态 -->
    <string name="physical_key_enable_title">启用实体按键手势</string>
    <string name="physical_key_enable_summary">监听底层物理按键事件并触发指定快捷动作</string>
